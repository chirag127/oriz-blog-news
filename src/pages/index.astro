---
/**
 * / — The Standpoint front page.
 *
 * News-desk layout: broadsheet front page with three distinct zones:
 *
 * 1. MASTHEAD DATELINE — edition, date, count (already in Header, echoed here
 *    as a section separator in the body)
 * 2. BREAKING TICKER — scrolling wire-service headline band (BreakingTicker)
 * 3. FRONT PAGE GRID — newspaper column layout:
 *    ┌──────────────────────────┬──────────────────┐
 *    │  LEAD STORY (2/3 width)  │  SECONDARY (1/3) │
 *    │  big gothic headline     │  3 brief items   │
 *    │  full dek paragraph      │  in column rules │
 *    └──────────────────────────┴──────────────────┘
 * 4. SECTION RULE — horizontal rule with "MORE ON THE WIRE" label
 * 5. DISPATCH LEDGER — compact 2-col grid of next 8 posts (not PostCard)
 * 6. DESKS STRIP — category index row (mono, color-coded)
 *
 * This layout is unique among the 24 oriz-blog-* siblings: it uses a
 * newspaper-column grid for above-the-fold content, the BreakingTicker
 * signature component, and a 2-column dispatch ledger not used anywhere else.
 */
import BreakingTicker from '~/components/BreakingTicker.astro'
import BaseLayout from '~/layouts/BaseLayout.astro'
import {
  getCategoriesWithCounts,
  getPublishedPosts,
  postVertical,
  readingTimeFor,
  slugifyTag,
  verticalFor,
  verticalLabel,
} from '~/lib/blog'
import { SITE_CONFIG } from '~/lib/config'

const allPosts = await getPublishedPosts()
const lead = allPosts[0]
const secondary = allPosts.slice(1, 4)
const ledger = allPosts.slice(4, 12)

const cats = await getCategoriesWithCounts()

const leadVertical = lead ? postVertical(lead) : 'personal'
const leadRt = lead ? (lead.data.readingTime ?? readingTimeFor(lead)) : ''

const now = new Date()
const editionLong = now.toLocaleDateString('en-GB', {
  weekday: 'long', day: 'numeric', month: 'long', year: 'numeric',
})
const dispatchWord = allPosts.length === 1 ? 'dispatch' : 'dispatches'

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: SITE_CONFIG.title,
  url: `${SITE_CONFIG.url}/`,
  description: SITE_CONFIG.description,
  author: { '@type': 'Person', name: SITE_CONFIG.author.name, url: SITE_CONFIG.author.url },
}
---

<BaseLayout
  title="oriz / news"
  description={SITE_CONFIG.description}
  jsonLd={jsonLd}
  hideSidebar
>
  {/* ── Breaking ticker ────────────────────────────────────────────── */}
  {allPosts.length > 0 && <BreakingTicker posts={allPosts.slice(0, 6)} />}

  <div class="fp-page">
    {/* ── Sub-masthead section ───────────────────────────────────── */}
    <div class="fp-sub-mast mono">
      <span class="fp-edition-tag">Wire dispatch</span>
      <span class="fp-sep" aria-hidden="true">·</span>
      <time datetime={now.toISOString().slice(0, 10)}>{editionLong}</time>
      <span class="fp-sep" aria-hidden="true">·</span>
      <span><span class="fp-count">{allPosts.length}</span> {dispatchWord} on file</span>
    </div>

    <hr class="fp-mastline" />

    {/* ── Front page: lead + secondary columns ──────────────────── */}
    {lead && (
      <section class="fp-front" aria-label="Front page">
        {/* Lead story — dominant left column */}
        <article class="fp-lead" data-vertical={leadVertical}>
          <a class="fp-lead-link" href={`/blog/${lead.id}`}>
            <span class="fp-lead-flag mono">
              <span class="fp-flag-tick" aria-hidden="true"></span>
              <span class="fp-flag-desk">{verticalLabel(leadVertical)}</span>
              <span class="fp-flag-label">Lead story</span>
            </span>
            <h2 class="fp-lead-hed">{lead.data.title}</h2>
            <p class="fp-lead-dek">{lead.data.description}</p>
            <span class="fp-lead-meta mono">
              <time datetime={lead.data.pubDate.toISOString()}>
                {lead.data.pubDate.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })}
              </time>
              <span aria-hidden="true">·</span>
              <span>{leadRt}</span>
            </span>
          </a>
        </article>

        {/* Column rule */}
        <div class="fp-col-rule" aria-hidden="true"></div>

        {/* Secondary column — 3 briefer stories */}
        {secondary.length > 0 && (
          <aside class="fp-secondary" aria-label="More stories">
            <p class="fp-secondary-hed mono">Also on the wire</p>
            <ul class="fp-sec-list">
              {secondary.map((p) => {
                const v = postVertical(p)
                return (
                  <li class="fp-sec-item" data-vertical={v}>
                    <a class="fp-sec-link" href={`/blog/${p.id}`}>
                      <span class="fp-sec-kicker mono">
                        <span class="fp-sec-tick" aria-hidden="true"></span>
                        {verticalLabel(v)}
                      </span>
                      <span class="fp-sec-title">{p.data.title}</span>
                      <time class="fp-sec-date mono" datetime={p.data.pubDate.toISOString()}>
                        {p.data.pubDate.toLocaleDateString('en-GB', { day: 'numeric', month: 'short' })}
                      </time>
                    </a>
                  </li>
                )
              })}
            </ul>
          </aside>
        )}
      </section>
    )}

    {/* ── Section rule ──────────────────────────────────────────── */}
    {ledger.length > 0 && (
      <div class="fp-section-rule" role="separator">
        <span class="fp-section-label mono">More on the wire</span>
      </div>
    )}

    {/* ── Dispatch ledger — 2-col grid ──────────────────────────── */}
    {ledger.length > 0 && (
      <section class="fp-ledger" aria-labelledby="ledger-head">
        <h2 id="ledger-head" class="sr-only">Dispatch ledger</h2>
        <ul class="fp-ledger-grid">
          {ledger.map((p) => {
            const v = postVertical(p)
            const rt = p.data.readingTime ?? readingTimeFor(p)
            return (
              <li class="fp-ledger-item" data-vertical={v}>
                <a class="fp-ledger-link" href={`/blog/${p.id}`}>
                  <span class="fp-ledger-kicker mono">
                    <span class="fp-ledger-tick" aria-hidden="true"></span>
                    <span class="fp-ledger-desk">{verticalLabel(v)}</span>
                    <time class="fp-ledger-date" datetime={p.data.pubDate.toISOString()}>
                      {p.data.pubDate.toLocaleDateString('en-GB', { day: 'numeric', month: 'short' })}
                    </time>
                  </span>
                  <span class="fp-ledger-title">{p.data.title}</span>
                  <span class="fp-ledger-rt mono">{rt}</span>
                </a>
              </li>
            )
          })}
        </ul>
        <p class="fp-all-link">
          <a href="/archive/">Read all {allPosts.length} dispatches in the archive →</a>
        </p>
      </section>
    )}

    {/* ── Desks strip ───────────────────────────────────────────── */}
    {cats.length > 0 && (
      <section class="fp-desks" aria-labelledby="desks-head">
        <h2 id="desks-head" class="fp-desks-label mono">Desks</h2>
        <p class="fp-desks-row">
          {cats.map((c, i) => (
            <>
              {i > 0 && <span class="fp-desks-sep" aria-hidden="true">·</span>}
              <a
                href={`/categories/${slugifyTag(c.category)}/`}
                class="fp-desk-link"
                data-vertical={verticalFor(c.category)}
              >
                <span class="fp-desk-name">{c.category}</span>
                <span class="fp-desk-count mono">({c.count})</span>
              </a>
            </>
          ))}
        </p>
      </section>
    )}
  </div>
</BaseLayout>

<style>
  /* ── page shell ─────────────────────────────────────────────────── */
  .fp-page {
    max-width: var(--container-page, 1100px);
    margin-inline: auto;
    padding-inline: clamp(1rem, 4vw, 2rem);
  }

  .sr-only {
    position: absolute; width: 1px; height: 1px;
    overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap;
  }

  /* ── sub-masthead ────────────────────────────────────────────────── */
  .fp-sub-mast {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-mute);
    padding-block: 0.875rem 0;
  }
  .fp-edition-tag { color: var(--flag); font-weight: 700; letter-spacing: 0.2em; }
  .fp-sep { color: var(--rule-strong); }
  .fp-count { color: var(--ink); font-weight: 600; }

  .fp-mastline {
    height: 3px;
    background: var(--ink);
    border: 0;
    margin: 0.5rem 0 0;
  }

  /* ── front page: lead + secondary ──────────────────────────────── */
  .fp-front {
    display: grid;
    grid-template-columns: 1fr 1px minmax(0, 320px);
    gap: 0;
    padding-block: 1.75rem 0;
    align-items: start;
  }

  /* Lead article */
  .fp-lead {
    --v: var(--v-personal);
    padding-right: clamp(1.25rem, 3vw, 2rem);
    padding-bottom: 1.5rem;
  }
  .fp-lead[data-vertical='dev'] { --v: var(--v-dev); }
  .fp-lead[data-vertical='finance'] { --v: var(--v-finance); }
  .fp-lead[data-vertical='culture'] { --v: var(--v-culture); }
  .fp-lead[data-vertical='health'] { --v: var(--v-health); }

  .fp-lead-link {
    display: grid;
    gap: 0.75rem;
    color: var(--ink);
    text-decoration: none;
  }
  .fp-lead-flag {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-mute);
  }
  .fp-flag-tick {
    width: 9px; height: 9px;
    background: var(--v);
    flex: 0 0 auto;
  }
  .fp-flag-desk { color: var(--v); font-weight: 600; }
  .fp-flag-label {
    color: var(--flag);
    font-weight: 700;
    border-left: 1px solid var(--rule);
    padding-left: 0.5rem;
  }
  .fp-lead-hed {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4.5vw, 3.25rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.0;
    margin: 0;
    max-width: 18ch;
    text-wrap: balance;
  }
  .fp-lead-link:hover .fp-lead-hed { color: var(--accent); }
  .fp-lead-dek {
    font-family: var(--font-serif);
    font-size: clamp(1.0625rem, 1.8vw, 1.25rem);
    line-height: 1.52;
    color: var(--ink-mute);
    margin: 0;
    max-width: 54ch;
  }
  .fp-lead-meta {
    display: inline-flex;
    gap: 0.5rem;
    font-size: 11px;
    letter-spacing: 0.06em;
    color: var(--ink-mute);
  }

  /* Column rule between lead and secondary */
  .fp-col-rule {
    width: 1px;
    background: var(--rule);
    align-self: stretch;
  }

  /* Secondary column */
  .fp-secondary {
    padding-left: clamp(1.25rem, 3vw, 2rem);
    padding-bottom: 1.5rem;
    border-bottom: 0;
  }
  .fp-secondary-hed {
    margin: 0 0 1rem;
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink-mute);
    font-weight: 500;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--rule);
  }
  .fp-sec-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
  }
  .fp-sec-item {
    --v: var(--v-personal);
    border-bottom: 1px solid color-mix(in oklab, var(--rule) 65%, transparent);
  }
  .fp-sec-item:last-child { border-bottom: 0; }
  .fp-sec-item[data-vertical='dev'] { --v: var(--v-dev); }
  .fp-sec-item[data-vertical='finance'] { --v: var(--v-finance); }
  .fp-sec-item[data-vertical='culture'] { --v: var(--v-culture); }
  .fp-sec-item[data-vertical='health'] { --v: var(--v-health); }

  .fp-sec-link {
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-rows: auto auto auto;
    gap: 0.2rem 0.5rem;
    padding-block: 0.875rem;
    color: var(--ink);
    text-decoration: none;
    padding-left: 0.625rem;
    margin-left: -0.625rem;
    border-left: 2px solid transparent;
    transition: border-color var(--dur-fast) ease;
    align-items: start;
  }
  .fp-sec-link:hover { border-left-color: var(--v); }
  .fp-sec-kicker {
    grid-column: 1 / -1;
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--v);
    font-weight: 600;
  }
  .fp-sec-tick {
    width: 6px; height: 6px;
    background: var(--v);
    flex: 0 0 auto;
  }
  .fp-sec-title {
    grid-column: 1 / -1;
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.22;
    color: var(--ink);
  }
  .fp-sec-link:hover .fp-sec-title { color: var(--accent); }
  .fp-sec-date {
    grid-column: 1 / -1;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    color: var(--ink-mute);
  }

  /* ── Section rule with label ─────────────────────────────────────── */
  .fp-section-rule {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-block: 0 0;
    border-top: 2px solid var(--ink);
    padding-top: 0.5rem;
  }
  .fp-section-label {
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink-mute);
    font-weight: 500;
    white-space: nowrap;
    flex: 0 0 auto;
  }

  /* ── Dispatch ledger — 2-col grid ──────────────────────────────── */
  .fp-ledger { padding-block: 1.25rem 1.5rem; }
  .fp-ledger-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
  }
  .fp-ledger-item {
    --v: var(--v-personal);
    border-bottom: 1px solid color-mix(in oklab, var(--rule) 70%, transparent);
  }
  .fp-ledger-item:nth-child(odd) { border-right: 1px solid var(--rule); }
  .fp-ledger-item[data-vertical='dev'] { --v: var(--v-dev); }
  .fp-ledger-item[data-vertical='finance'] { --v: var(--v-finance); }
  .fp-ledger-item[data-vertical='culture'] { --v: var(--v-culture); }
  .fp-ledger-item[data-vertical='health'] { --v: var(--v-health); }

  .fp-ledger-link {
    display: grid;
    gap: 0.2rem;
    padding: 0.875rem 0.875rem 0.875rem 0.75rem;
    color: var(--ink);
    text-decoration: none;
    border-left: 2px solid transparent;
    margin-left: -2px;
    transition: border-color var(--dur-fast) ease;
  }
  .fp-ledger-item:nth-child(odd) .fp-ledger-link { padding-right: 1.25rem; }
  .fp-ledger-item:nth-child(even) .fp-ledger-link { padding-left: 1.25rem; margin-left: 0; border-left: 0; border-right: 2px solid transparent; margin-right: -2px; }
  .fp-ledger-link:hover { border-left-color: var(--v); border-right-color: var(--v); }
  .fp-ledger-kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-mute);
  }
  .fp-ledger-tick {
    width: 6px; height: 6px;
    background: var(--v);
    flex: 0 0 auto;
  }
  .fp-ledger-desk { color: var(--v); font-weight: 600; }
  .fp-ledger-date { border-left: 1px solid var(--rule); padding-left: 0.4rem; }
  .fp-ledger-title {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: -0.015em;
    line-height: 1.22;
    color: var(--ink);
  }
  .fp-ledger-link:hover .fp-ledger-title { color: var(--accent); }
  .fp-ledger-rt {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.06em;
    color: var(--ink-mute);
  }
  .fp-all-link {
    margin: 1.25rem 0 0;
    font-size: 13px;
    font-family: var(--font-sans);
  }
  .fp-all-link a {
    color: var(--ink-mute);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--rule);
  }
  .fp-all-link a:hover { color: var(--accent); text-decoration-color: var(--accent); }

  /* ── Desks strip ─────────────────────────────────────────────────── */
  .fp-desks {
    border-top: 1px solid var(--rule);
    padding-block: 1.25rem 2rem;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1rem;
    align-items: baseline;
  }
  .fp-desks-label {
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink-mute);
    font-weight: 500;
    margin: 0;
    white-space: nowrap;
  }
  .fp-desks-row {
    margin: 0;
    line-height: 2;
  }
  .fp-desks-sep { color: var(--rule-strong); margin-inline: 0.625rem; }
  .fp-desk-link {
    --v: var(--v-personal);
    color: var(--ink);
    text-decoration: none;
    margin-inline: 0.1rem;
  }
  .fp-desk-link[data-vertical='dev'] { --v: var(--v-dev); }
  .fp-desk-link[data-vertical='finance'] { --v: var(--v-finance); }
  .fp-desk-link[data-vertical='culture'] { --v: var(--v-culture); }
  .fp-desk-link[data-vertical='health'] { --v: var(--v-health); }
  .fp-desk-link:hover .fp-desk-name { color: var(--v); }
  .fp-desk-name {
    font-family: var(--font-display);
    font-size: 16px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .fp-desk-count {
    color: var(--ink-mute);
    font-family: var(--font-mono);
    font-size: 11px;
    margin-left: 0.2rem;
  }

  /* ── responsive ─────────────────────────────────────────────────── */
  @media (max-width: 900px) {
    .fp-front {
      grid-template-columns: 1fr;
    }
    .fp-col-rule { display: none; }
    .fp-lead { padding-right: 0; border-bottom: 1px solid var(--rule); margin-bottom: 1.5rem; }
    .fp-secondary { padding-left: 0; }
    .fp-desks { grid-template-columns: 1fr; gap: 0.5rem; }
  }

  @media (max-width: 600px) {
    .fp-ledger-grid { grid-template-columns: 1fr; }
    .fp-ledger-item:nth-child(odd) { border-right: 0; }
    .fp-ledger-item:nth-child(even) .fp-ledger-link {
      padding-left: 0.75rem;
      margin-left: -2px;
      border-left: 2px solid transparent;
      border-right: 0;
      margin-right: 0;
    }
    .fp-sub-mast { font-size: 10px; gap: 0.35rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .fp-lead-link,
    .fp-sec-link,
    .fp-ledger-link { transition: none; }
  }
</style>
